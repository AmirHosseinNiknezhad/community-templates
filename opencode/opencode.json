{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "green", "cyan", "yellow", "purple"],
    "text": {
      "base": "{{ colors.on_surface.default.hex }}",
      "muted": "{{ colors.on_surface.default.hex | darken 30 }}",
      "action": {
        "primary": {
          "base": "{{ colors.on_surface.default.hex }}",
          "$disabled": "{{ colors.on_surface_variant.default.hex }}",
          "$focused": "{{ colors.on_primary.default.hex }}",
          "$selected": "{{ colors.on_primary_container.default.hex }}"
        },
        "secondary": {
          "base": "{{ colors.on_surface_variant.default.hex }}",
          "$hovered": "{{ colors.on_surface.default.hex }}"
        },
        "destructive": {
          "base": "{{ colors.on_error.default.hex }}",
          "$disabled": "{{ colors.on_surface_variant.default.hex }}"
        }
      },
      "formfield": {
        "base": "{{ colors.on_surface.default.hex }}",
        "$hovered": "{{ colors.on_primary_container.default.hex }}",
        "$focused": "{{ colors.on_primary_container.default.hex }}",
        "$pressed": "{{ colors.on_primary_container.default.hex }}",
        "$disabled": "{{ colors.on_surface_variant.default.hex }}",
        "$selected": "{{ colors.on_primary_container.default.hex }}"
      },
      "feedback": {
        "error": { "base": "{{ colors.error.default.hex }}" },
        "warning": { "base": "{{ colors.terminal_normal_yellow.default.hex }}" },
        "success": { "base": "{{ colors.terminal_normal_green.default.hex }}" },
        "info": { "base": "{{ colors.terminal_normal_cyan.default.hex }}" }
      }
    },
    "background": {
      "base": "{{ colors.background.default.hex }}",
      "raised": {
        "base": "{{ colors.surface_container.default.hex }}",
        "high": "{{ colors.surface_container_high.default.hex }}",
        "max": "{{ colors.surface_container_highest.default.hex }}"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "{{ colors.surface_container_high.default.hex }}",
          "$focused": "{{ colors.primary.default.hex }}",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "{{ colors.error.default.hex }}" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "{{ colors.outline_variant.default.hex }}" },
    "scrollbar": { "base": "{{ colors.outline.default.hex }}" },
    "diff": {
      "text": {
        "added": "{{ colors.terminal_normal_green.default.hex }}",
        "removed": "{{ colors.terminal_normal_red.default.hex }}",
        "context": "{{ colors.on_surface_variant.default.hex }}",
        "hunkHeader": "{{ colors.on_surface_variant.default.hex }}"
      },
      "background": {
        "added": "{{ colors.terminal_normal_green.default.hex | set_lightness 20 | desaturate 30 }}",
        "removed": "{{ colors.terminal_normal_red.default.hex | set_lightness 20 | desaturate 30 }}",
        "context": "{{ colors.background.default.hex }}"
      },
      "highlight": {
        "added": "{{ colors.terminal_bright_green.default.hex | lighten 8 }}",
        "removed": "{{ colors.terminal_bright_red.default.hex | lighten 8 }}"
      },
      "lineNumber": {
        "text": "{{ colors.on_surface_variant.default.hex }}",
        "background": {
          "added": "{{ colors.terminal_normal_green.default.hex | set_lightness 15 | desaturate 28 }}",
          "removed": "{{ colors.terminal_normal_red.default.hex | set_lightness 15 | desaturate 28 }}"
        }
      }
    },
    "syntax": {
      "comment": "{{ colors.on_surface_variant.default.hex }}",
      "keyword": "{{ colors.terminal_normal_magenta.default.hex }}",
      "function": "{{ colors.terminal_normal_blue.default.hex }}",
      "variable": "{{ colors.on_surface.default.hex }}",
      "string": "{{ colors.terminal_normal_green.default.hex }}",
      "number": "{{ colors.terminal_normal_yellow.default.hex }}",
      "type": "{{ colors.terminal_normal_cyan.default.hex }}",
      "operator": "{{ colors.terminal_normal_cyan.default.hex }}",
      "punctuation": "{{ colors.on_surface.default.hex }}"
    },
    "markdown": {
      "text": "{{ colors.on_surface.default.hex | lighten 8 }}",
      "heading": "{{ colors.on_primary_container.default.hex }}",
      "link": "{{ colors.terminal_normal_blue.default.hex }}",
      "linkText": "{{ colors.terminal_normal_cyan.default.hex }}",
      "code": "{{ colors.terminal_normal_green.default.hex }}",
      "blockQuote": "{{ colors.terminal_normal_yellow.default.hex }}",
      "emphasis": "{{ colors.terminal_normal_yellow.default.hex }}",
      "strong": "{{ colors.on_surface.default.hex }}",
      "horizontalRule": "{{ colors.outline_variant.default.hex }}",
      "listItem": "{{ colors.terminal_normal_blue.default.hex }}",
      "listEnumeration": "{{ colors.terminal_normal_cyan.default.hex }}",
      "image": "{{ colors.terminal_normal_blue.default.hex }}",
      "imageText": "{{ colors.terminal_normal_cyan.default.hex }}",
      "codeBlock": "{{ colors.on_surface.default.hex }}"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": { "primary": { "$hovered": "$background.raised.high" } }
      }
    }
  },
  "dark": {
    "hue": {
      "neutral": {
        "100": "{{ colors.on_surface.default.hex | set_lightness 88 }}",
        "200": "{{ colors.on_surface.default.hex | set_lightness 80 }}",
        "300": "{{ colors.on_surface.default.hex | set_lightness 72 }}",
        "400": "{{ colors.on_surface.default.hex | set_lightness 64 }}",
        "500": "{{ colors.on_surface.default.hex | set_lightness 56 }}",
        "600": "{{ colors.on_surface.default.hex | set_lightness 46 }}",
        "700": "{{ colors.on_surface.default.hex | set_lightness 36 }}",
        "800": "{{ colors.on_surface.default.hex | set_lightness 26 }}",
        "900": "{{ colors.on_surface.default.hex | set_lightness 18 }}"
      },
      "interactive": {
        "100": "{{ colors.primary.default.hex | set_lightness 88 }}",
        "200": "{{ colors.primary.default.hex | set_lightness 80 }}",
        "300": "{{ colors.primary.default.hex | set_lightness 72 }}",
        "400": "{{ colors.primary.default.hex | set_lightness 64 }}",
        "500": "{{ colors.primary.default.hex | set_lightness 56 }}",
        "600": "{{ colors.primary.default.hex | set_lightness 46 }}",
        "700": "{{ colors.primary.default.hex | set_lightness 36 }}",
        "800": "{{ colors.primary.default.hex | set_lightness 26 }}",
        "900": "{{ colors.primary.default.hex | set_lightness 18 }}"
      },
      "accent": {
        "100": "{{ colors.secondary.default.hex | set_lightness 88 }}",
        "200": "{{ colors.secondary.default.hex | set_lightness 80 }}",
        "300": "{{ colors.secondary.default.hex | set_lightness 72 }}",
        "400": "{{ colors.secondary.default.hex | set_lightness 64 }}",
        "500": "{{ colors.secondary.default.hex | set_lightness 56 }}",
        "600": "{{ colors.secondary.default.hex | set_lightness 46 }}",
        "700": "{{ colors.secondary.default.hex | set_lightness 36 }}",
        "800": "{{ colors.secondary.default.hex | set_lightness 26 }}",
        "900": "{{ colors.secondary.default.hex | set_lightness 18 }}"
      },
      "green": {
        "100": "{{ colors.terminal_normal_green.default.hex | set_lightness 88 }}",
        "200": "{{ colors.terminal_normal_green.default.hex | set_lightness 80 }}",
        "300": "{{ colors.terminal_normal_green.default.hex | set_lightness 72 }}",
        "400": "{{ colors.terminal_normal_green.default.hex | set_lightness 64 }}",
        "500": "{{ colors.terminal_normal_green.default.hex | set_lightness 56 }}",
        "600": "{{ colors.terminal_normal_green.default.hex | set_lightness 46 }}",
        "700": "{{ colors.terminal_normal_green.default.hex | set_lightness 36 }}",
        "800": "{{ colors.terminal_normal_green.default.hex | set_lightness 26 }}",
        "900": "{{ colors.terminal_normal_green.default.hex | set_lightness 18 }}"
      },
      "cyan": {
        "100": "{{ colors.terminal_normal_cyan.default.hex | set_lightness 88 }}",
        "200": "{{ colors.terminal_normal_cyan.default.hex | set_lightness 80 }}",
        "300": "{{ colors.terminal_normal_cyan.default.hex | set_lightness 72 }}",
        "400": "{{ colors.terminal_normal_cyan.default.hex | set_lightness 64 }}",
        "500": "{{ colors.terminal_normal_cyan.default.hex | set_lightness 56 }}",
        "600": "{{ colors.terminal_normal_cyan.default.hex | set_lightness 46 }}",
        "700": "{{ colors.terminal_normal_cyan.default.hex | set_lightness 36 }}",
        "800": "{{ colors.terminal_normal_cyan.default.hex | set_lightness 26 }}",
        "900": "{{ colors.terminal_normal_cyan.default.hex | set_lightness 18 }}"
      },
      "yellow": {
        "100": "{{ colors.terminal_normal_yellow.default.hex | set_lightness 88 }}",
        "200": "{{ colors.terminal_normal_yellow.default.hex | set_lightness 80 }}",
        "300": "{{ colors.terminal_normal_yellow.default.hex | set_lightness 72 }}",
        "400": "{{ colors.terminal_normal_yellow.default.hex | set_lightness 64 }}",
        "500": "{{ colors.terminal_normal_yellow.default.hex | set_lightness 56 }}",
        "600": "{{ colors.terminal_normal_yellow.default.hex | set_lightness 46 }}",
        "700": "{{ colors.terminal_normal_yellow.default.hex | set_lightness 36 }}",
        "800": "{{ colors.terminal_normal_yellow.default.hex | set_lightness 26 }}",
        "900": "{{ colors.terminal_normal_yellow.default.hex | set_lightness 18 }}"
      },
      "purple": {
        "100": "{{ colors.terminal_normal_magenta.default.hex | set_lightness 88 }}",
        "200": "{{ colors.terminal_normal_magenta.default.hex | set_lightness 80 }}",
        "300": "{{ colors.terminal_normal_magenta.default.hex | set_lightness 72 }}",
        "400": "{{ colors.terminal_normal_magenta.default.hex | set_lightness 64 }}",
        "500": "{{ colors.terminal_normal_magenta.default.hex | set_lightness 56 }}",
        "600": "{{ colors.terminal_normal_magenta.default.hex | set_lightness 46 }}",
        "700": "{{ colors.terminal_normal_magenta.default.hex | set_lightness 36 }}",
        "800": "{{ colors.terminal_normal_magenta.default.hex | set_lightness 26 }}",
        "900": "{{ colors.terminal_normal_magenta.default.hex | set_lightness 18 }}"
      }
    }
  }
}
